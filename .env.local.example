# MSG91 SMS Gateway (for OTP sending to Indian mobile numbers)
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_OTP_TEMPLATE_ID=your_otp_template_id_here

# Nodemailer (for OTP via email fallback)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
OTP_EMAIL_FROM=noreply@khandeshvivah.com

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/khandeshvivah
